{
  "expo": {
    "name": "RPilot",
    "slug": "rpilot",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "rpilot",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.rpilot.app",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "RPilot szuka robota Raspberry Pi w Twojej sieci Wi‑Fi i łączy się z nim przez UDP.",
        "NSMicrophoneUsageDescription": "RPilot używa mikrofonu, żeby zamienić głos na polecenia dla robota.",
        "NSSpeechRecognitionUsageDescription": "RPilot rozpoznaje mowę na telefonie, bez komputera.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "dev.rpilot.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#07090d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "CHANGE_WIFI_STATE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "RPilot"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "RPilot używa mikrofonu, żeby zamienić głos na polecenia dla robota.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "RPilot używa mikrofonu, żeby zamienić głos na polecenia dla robota.",
          "speechRecognitionPermission": "RPilot rozpoznaje mowę na telefonie, bez komputera.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as",
            "com.huawei.hiai",
            "com.huawei.vassistant",
            "com.huawei.hwvoicerecognition",
            "com.hihonor.voice",
            "com.samsung.android.bixby.agent",
            "com.miui.voiceassist",
            "com.xiaomi.mibrain.speech"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b5d695b-b817-4300-b6f7-4ce0c15328a0"
      }
    }
  }
}
