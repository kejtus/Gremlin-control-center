[Unit]
Description=Gremlin simulator / phone UI (HTTP + WS + UDP discovery)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rpilot/rpi
ExecStart=/usr/bin/python3 /opt/rpilot/rpi/rpilot_agent.py --host 0.0.0.0 --port 8742
Restart=on-failure
RestartSec=2
Environment=GREMLIN_NAME=Gremlin

[Install]
WantedBy=multi-user.target
